body {
  font-family: 'Open Sans', sans-serif;
  line-height: 1.6;
  margin: 0;
  padding: 0;
  color: #333;
}

h1, h2 {
  font-family: 'Montserrat', sans-serif;
  color: #004080;
}

header {
  text-align: center;
  padding: 40px 20px;
  background: linear-gradient(to right, #e6f2ff, #ffffff);
}
.logo {
  width: 80px;
  margin-bottom: 10px;
}

nav {
  background: #004080;
  padding: 10px;
  text-align: center;
}
nav a {
  color: #fff;
  margin: 0 15px;
  text-decoration: none;
}
nav a:hover {
  text-decoration: underline;
}

section {
  padding: 60px 20px;
}

.project {
  margin-bottom: 20px;
}
.project img {
  width: 100px;
  margin-right: 10px;
}

footer {
  text-align: center;
  background: #f2f2f2;
  padding: 20px;
  margin-top: 40px;
}

html {
  scroll-behavior: smooth;
}
